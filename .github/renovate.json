{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "dependencyDashboard": true,
  "description": [
    "Do not extend ':ignoreModulesAndTests', even via 'config:recommended' or",
    "'config:best-practices': it ignores '**/test/**', and the chainsaw fixtures under ci/test/",
    "pin the same images the modules run, so their pins would drift unreported. The",
    "'kubernetes.ignorePaths' entry below is unrelated (see disable-updates.json).",
    "",
    "internalChecksFilter 'strict': an update whose minimumReleaseAge has not elapsed gets no",
    "branch and no PR -- a soak is a silent hold, not a delay; override-release-age.json depends",
    "on this.",
    "",
    "The flux and kubernetes managerFilePatterns include ci/ and components/: fixtures and",
    "shared components carry pins of their own."
  ],
  "extends": [
    "abandonments:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "mergeConfidence:age-confidence-badges",
    "mergeConfidence:all-badges",
    "workarounds:bitnamiDockerImageVersioning",
    "workarounds:k3sKubernetesVersioning",
    "github>ppat/renovate-presets#v1.0.0",
    "github>ppat/renovate-presets:dev-tools#v1.0.0",
    "github>ppat/renovate-presets:github-actions#v1.0.0",
    "github>ppat/renovate-presets:kubernetes#v1.0.0",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/custom-managers",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/organize-labels-deptype",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/organize-labels-subsystem",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/organize-semantic-scope",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/group-related-updates",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/version-separation",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/version-scheme",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/override-breaking-changes",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/override-calver",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/disable-automerge",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/disable-updates.json",
    "github>ppat/homelab-ops-kubernetes-apps//.github/renovate/override-release-age"
  ],
  "flux": {
    "managerFilePatterns": [
      "/apps/.+\\.yaml$/",
      "/ci/.+\\.yaml$/",
      "/components/.+\\.yaml$/",
      "/infrastructure/.+\\.yaml$/"
    ]
  },
  "internalChecksFilter": "strict",
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.+\\.yaml$/",
      "/ci/.+\\.yaml$/",
      "/components/.+\\.yaml$/",
      "/infrastructure/.+\\.yaml$/"
    ],
    "ignorePaths": [
      "infrastructure/subsystems/clusterops-core/flux/gotk-components.yaml"
    ]
  },
  "labels": [
    "pr-type:renovate"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "printConfig": true,
  "rebaseWhen": "behind-base-branch",
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "timezone": "US/Eastern"
}
